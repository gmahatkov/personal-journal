	"type": "module",
	"dependencies": {
		"@auth/core": "^0.37.4",
		"@auth/prisma-adapter": "^2.7.4",
		"@auth/sveltekit": "^1.11.1",
		"@popperjs/core": "^2.11.8",
		"@prisma/client": "^5.22.0",
		"@types/node": "^20.19.24",
		"flowbite": "^2.5.2",
		"flowbite-svelte": "^0.46.23",
		"flowbite-svelte-icons": "^1.6.2",
		"googleapis": "^140.0.1",
		"sharp": "^0.33.5",
		"tailwind-merge": "^2.6.0"
	}
